@import url('https://fonts.googleapis.com/css2?family=Prata&family=Tajawal:wght@300;400;500;700;800;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --black: #080808;
  --black-soft: #101010;
  --black-elevated: #161616;
  --accent: #c8a96e;
  --accent-light: #e2c98a;
  --accent-dark: #a8893e;
  --text: #f5f1e8;
  --muted: #aaa49a;
  --glass: rgba(22, 22, 22, 0.82);
  --border-subtle: rgba(255, 255, 255, 0.1);
  --border-accent: rgba(200, 169, 110, 0.42);
  --glass-backdrop: blur(16px);
  --grain-texture: url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.065'/%3E%3C/svg%3E");
  --shadow-card: 0 12px 36px rgba(0, 0, 0, 0.35);
  --shadow-hover: 0 24px 60px rgba(0, 0, 0, 0.58);
  --radius-card: 12px;
  --radius-modal: 16px;
  --ease-premium: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

* { box-sizing: border-box; }
html { min-height: 100%; scroll-behavior: smooth; background: var(--black); }
body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  background: var(--black);
  background-image: var(--grain-texture);
  background-attachment: fixed;
  color: var(--text);
  font-family: 'Tajawal', sans-serif;
}
body, button, input, select, textarea { font-family: 'Tajawal', sans-serif; }
button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; }
img { max-width: 100%; }
a { color: inherit; }

::selection { background: var(--accent); color: var(--black); }
::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-track { background: var(--black); }
::-webkit-scrollbar-thumb { background: #383838; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }
* { scrollbar-width: thin; scrollbar-color: #383838 var(--black); }

@keyframes fadeInUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes scaleIn { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: scale(1); } }
@keyframes shimmer { from { background-position: -200% 0; } to { background-position: 200% 0; } }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes marqueeRtl { from { transform: translateX(0); } to { transform: translateX(50%); } }

.app-shell { min-height: 100vh; display: flex; flex-direction: column; }
.page-container { width: min(1320px, calc(100% - 40px)); margin-inline: auto; }
.page-content { flex: 1; min-height: 62vh; padding-block: 46px 80px; animation: fadeIn .35s var(--ease-premium); }
.page-heading { margin: 0 0 28px; font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; letter-spacing: -.03em; color: var(--text); }
.eyebrow { display: block; color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .19em; text-transform: uppercase; margin-bottom: 10px; }
.muted { color: var(--muted); }
.premium-card { background: var(--glass); border: 1px solid var(--border-subtle); border-radius: var(--radius-card); box-shadow: var(--shadow-card); backdrop-filter: var(--glass-backdrop); -webkit-backdrop-filter: var(--glass-backdrop); }
.glass-input { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid var(--border-subtle); border-radius: 9px; outline: none; background: rgba(8,8,8,.62); color: var(--text); transition: border-color .35s var(--ease-premium), background .35s var(--ease-premium); }
.glass-input::placeholder { color: #77736e; }
.glass-input:focus { border-color: var(--accent); background: rgba(8,8,8,.86); }
.premium-button, .premium-button-outline { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 11px 21px; border-radius: 999px; border: 1px solid transparent; font-size: .88rem; font-weight: 800; text-decoration: none; transition: transform .35s var(--ease-spring), background .35s var(--ease-premium), border-color .35s var(--ease-premium), color .35s var(--ease-premium); }
.premium-button { background: var(--accent); color: var(--black); }
.premium-button:hover { transform: translateY(-2px) scale(1.02); background: var(--accent-light); }
.premium-button-outline { background: transparent; color: var(--text); border-color: var(--border-subtle); }
.premium-button-outline:hover { transform: translateY(-2px); color: var(--accent); border-color: var(--accent); }
.icon-button { width: 40px; height: 40px; display: inline-grid; place-items: center; border: 1px solid var(--border-subtle); border-radius: 50%; background: transparent; color: var(--text); transition: .35s var(--ease-premium); }
.icon-button:hover { border-color: var(--accent); color: var(--accent); background: rgba(200,169,110,.08); transform: translateY(-2px); }
.icon-button img { width: 17px; filter: invert(1); opacity: .85; }
.icon-button:hover img { opacity: 1; }

.announcement-bar { overflow: hidden; height: 34px; background: #0d0d0d; border-bottom: 1px solid var(--border-subtle); color: var(--accent); white-space: nowrap; }
.announcement-track { display: inline-flex; min-width: max-content; height: 100%; align-items: center; animation: marquee 20s linear infinite; }
.announcement-bar:hover .announcement-track { animation-play-state: paused; }
[dir='rtl'] .announcement-track { animation-name: marqueeRtl; }
.announcement-item { display: inline-flex; align-items: center; gap: 18px; padding-inline: 28px; font-size: .72rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
.announcement-item::before { content: '✦'; font-size: .72rem; }

.site-header { position: sticky; top: 0; z-index: 60; transition: background .35s var(--ease-premium), border-color .35s var(--ease-premium), box-shadow .35s var(--ease-premium); }
.site-header.scrolled { background: var(--glass); border-bottom: 1px solid var(--border-subtle); box-shadow: 0 10px 34px rgba(0,0,0,.32); backdrop-filter: var(--glass-backdrop); -webkit-backdrop-filter: var(--glass-backdrop); }
.header-inner { width: min(1320px, calc(100% - 40px)); min-height: 74px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.header-logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
.header-logo img { width: 94px; height: 52px; object-fit: contain; transition: transform .35s var(--ease-spring); }
.header-logo:hover img { transform: scale(1.04); }
.desktop-nav { display: flex; align-items: center; gap: 6px; }
.nav-link { position: relative; padding: 10px 13px; color: var(--muted); font-size: .86rem; font-weight: 700; text-decoration: none; transition: color .35s var(--ease-premium); }
.nav-link::after { content: ''; position: absolute; inset-inline: 13px; bottom: 5px; height: 1px; background: var(--accent); transform: scaleX(0); transition: transform .35s var(--ease-premium); }
.nav-link:hover, .nav-link.active { color: var(--text); }
.nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
.header-actions { display: flex; align-items: center; gap: 9px; }
.language-button { width: auto; min-width: 42px; padding-inline: 10px; border-radius: 999px; font-size: .72rem; font-weight: 900; }
.profile-menu { position: relative; }
.profile-dropdown { position: absolute; top: calc(100% + 10px); min-width: 150px; padding: 8px; background: rgba(20,20,20,.97); border: 1px solid var(--border-subtle); border-radius: 10px; box-shadow: var(--shadow-hover); animation: scaleIn .2s ease; }
.profile-dropdown.end { inset-inline-end: 0; }
.profile-dropdown button { width: 100%; padding: 9px 11px; border: 0; border-radius: 7px; text-align: start; background: transparent; color: var(--muted); font-size: .85rem; }
.profile-dropdown button:hover { color: var(--accent); background: rgba(255,255,255,.045); }
.cart-link { position: relative; }
.cart-count { position: absolute; inset-block-start: -5px; inset-inline-end: -5px; min-width: 17px; height: 17px; padding-inline: 3px; display: grid; place-items: center; background: var(--accent); color: var(--black); border-radius: 99px; font-size: .6rem; font-weight: 900; }
.mobile-trigger { display: none; }

.mobile-menu-backdrop { position: fixed; inset: 0; z-index: 80; background: rgba(0,0,0,.68); opacity: 0; pointer-events: none; transition: opacity .35s var(--ease-premium); }
.mobile-menu-backdrop.open { opacity: 1; pointer-events: auto; }
.mobile-menu { position: fixed; z-index: 81; inset-block: 0; inset-inline-end: 0; width: min(84vw, 320px); display: flex; flex-direction: column; background: rgba(16,16,16,.96); border-inline-start: 1px solid var(--border-subtle); backdrop-filter: blur(20px); transform: translateX(105%); transition: transform .35s var(--ease-premium); }
[dir='rtl'] .mobile-menu { inset-inline-start: 0; inset-inline-end: auto; transform: translateX(-105%); border-inline-start: 0; border-inline-end: 1px solid var(--border-subtle); }
.mobile-menu.open { transform: translateX(0); }
.mobile-menu-top { display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-subtle); }
.mobile-menu-links { padding: 16px; display: grid; gap: 4px; }
.mobile-menu-links a { padding: 15px 13px; color: var(--muted); text-decoration: none; border-radius: 8px; font-weight: 700; }
.mobile-menu-links a.active, .mobile-menu-links a:hover { color: var(--accent); background: rgba(200,169,110,.08); }
.mobile-menu-bottom { margin-top: auto; padding: 22px; border-top: 1px solid var(--border-subtle); }
.mobile-language { width: 100%; }

.search-overlay { position: fixed; z-index: 100; inset: 0; padding: 86px 20px 32px; background: rgba(8,8,8,.96); backdrop-filter: blur(20px); animation: fadeIn .25s ease; }
.search-panel { width: min(100%, 760px); margin: auto; animation: scaleIn .3s var(--ease-premium); }
.search-input-wrap { position: relative; }
.search-input-wrap input { padding-inline-end: 54px; min-height: 58px; font-size: 1rem; }
.search-input-wrap .icon-button { position: absolute; inset-inline-end: 9px; top: 9px; width: 40px; height: 40px; }
.search-results { margin-top: 14px; overflow: auto; max-height: calc(100vh - 180px); background: rgba(18,18,18,.94); border: 1px solid var(--border-subtle); border-radius: var(--radius-card); }
.search-result { display: grid; grid-template-columns: 66px 1fr auto; gap: 14px; align-items: center; padding: 12px; border-bottom: 1px solid var(--border-subtle); cursor: pointer; transition: background .25s; }
.search-result:last-child { border-bottom: 0; }
.search-result:hover { background: rgba(255,255,255,.045); }
.search-result img { width: 66px; height: 66px; object-fit: cover; border-radius: 8px; background: var(--black-elevated); }
.match { color: var(--accent); }

.hero { position: relative; overflow: hidden; min-height: min(760px, calc(100vh - 34px)); display: grid; place-items: center; background: radial-gradient(ellipse at 80% 45%, rgba(200,169,110,.12), transparent 42%), radial-gradient(ellipse at 12% 58%, rgba(255,255,255,.045), transparent 45%), var(--black); }
.hero::before { content: ''; position: absolute; inset: 0; background-image: var(--grain-texture); opacity: .45; pointer-events: none; }
.hero-grid { position: relative; z-index: 1; width: min(1320px, calc(100% - 40px)); display: grid; grid-template-columns: .88fr 1.12fr; gap: clamp(28px, 6vw, 90px); align-items: center; padding-block: 76px; }
.hero-copy { max-width: 560px; animation: fadeInUp .7s var(--ease-premium) both; }
.hero-title { margin: 0; font-size: clamp(3rem, 6.5vw, 6.2rem); font-weight: 900; line-height: .97; letter-spacing: -.08em; color: var(--text); }
.hero-title span { color: var(--accent); }
.hero-subtitle { max-width: 450px; margin: 22px 0 31px; color: var(--muted); font-size: clamp(.96rem, 1.6vw, 1.14rem); line-height: 1.9; }
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.hero-visual { position: relative; animation: fadeIn .85s var(--ease-premium) both; }
.hero-image-wrap { aspect-ratio: 4 / 5; overflow: hidden; border: 1px solid var(--border-accent); border-radius: var(--radius-modal); box-shadow: 26px 28px 0 rgba(200,169,110,.08), var(--shadow-hover); background: var(--black-elevated); }
.hero-image-wrap img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.75) contrast(1.05); transition: transform .8s var(--ease-premium); }
.hero:hover .hero-image-wrap img { transform: scale(1.04); }
.hero-note { position: absolute; inset-inline-start: -28px; inset-block-end: 30px; max-width: 180px; padding: 16px; background: rgba(20,20,20,.91); border: 1px solid var(--border-accent); border-radius: 10px; box-shadow: var(--shadow-card); font-size: .74rem; color: var(--muted); }
.hero-note strong { display: block; margin-bottom: 3px; color: var(--accent); font-size: .92rem; }

.section { padding-block: clamp(55px, 8vw, 108px); }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 28px; }
.section-heading h2 { margin: 0; font-size: clamp(1.7rem, 3.3vw, 3rem); line-height: 1.05; }
.section-heading p { max-width: 520px; margin: 0; color: var(--muted); line-height: 1.8; }
.products-grid, .skeleton-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.product-card { overflow: hidden; position: relative; border: 1px solid var(--border-subtle); border-radius: var(--radius-card); background: rgba(20,20,20,.75); box-shadow: var(--shadow-card); transition: transform .35s var(--ease-premium), border-color .35s var(--ease-premium), box-shadow .35s var(--ease-premium); animation: fadeInUp .45s var(--ease-premium) both; }
.product-card:hover { transform: translateY(-6px); border-color: var(--border-accent); box-shadow: var(--shadow-hover); }
.product-image-link { display: block; aspect-ratio: 1; overflow: hidden; background: var(--black-elevated); }
.product-image-link img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s var(--ease-premium), opacity .3s; }
.product-card:hover .product-image-link img { transform: scale(1.05); }
.product-image-link img.loading { opacity: .24; }
.product-info { padding: 15px; }
.product-category { margin-bottom: 4px; color: var(--accent); font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
.product-name { display: block; overflow: hidden; color: var(--text); font-weight: 800; line-height: 1.35; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
.product-name:hover { color: var(--accent); }
.product-price-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 9px; }
.product-price { color: var(--accent); font-size: .93rem; font-weight: 900; }
.quick-view { border: 0; padding: 5px 0; background: transparent; color: var(--muted); font-size: .72rem; font-weight: 800; }
.quick-view:hover { color: var(--accent); }
.skeleton-card { opacity: .76; }
.skeleton-image, .skeleton-line { border-radius: 10px; background: linear-gradient(90deg, #171717 0%, #2c2c2c 50%, #171717 100%); background-size: 200% 100%; animation: shimmer 1.45s linear infinite; }
.skeleton-image { aspect-ratio: 1; }
.skeleton-line { height: 14px; margin-top: 14px; }
.skeleton-line.short { width: 42%; }

.collection-layout { display: grid; grid-template-columns: 240px 1fr; gap: 32px; }
.filters { align-self: start; padding: 20px; }
.filter-title { margin: 0 0 14px; color: var(--text); font-size: .9rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
.filter-group { display: grid; gap: 10px; padding-block: 16px; border-top: 1px solid var(--border-subtle); }
.filter-label { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .88rem; cursor: pointer; }
.filter-label input { accent-color: var(--accent); }
.collection-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px; }
.collection-toolbar select { min-height: 40px; padding: 0 12px; color: var(--text); background: var(--black-elevated); border: 1px solid var(--border-subtle); border-radius: 8px; outline: none; }

.modal-backdrop { position: fixed; z-index: 110; inset: 0; display: grid; place-items: center; padding: 20px; overflow: auto; background: rgba(0,0,0,.73); backdrop-filter: blur(7px); animation: fadeIn .25s ease; }
.product-modal { position: relative; width: min(100%, 1020px); display: grid; grid-template-columns: 1.08fr .92fr; overflow: hidden; background: #121212; border: 1px solid var(--border-accent); border-radius: var(--radius-modal); box-shadow: var(--shadow-hover); animation: scaleIn .35s var(--ease-premium); }
.modal-gallery { padding: 22px; background: #0e0e0e; }
.modal-main-image { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; background: var(--black-elevated); }
.modal-thumbnails { display: flex; gap: 9px; margin-top: 11px; overflow-x: auto; }
.modal-thumbnail { flex: 0 0 58px; width: 58px; height: 58px; padding: 0; overflow: hidden; border: 1px solid transparent; border-radius: 8px; background: var(--black-elevated); }
.modal-thumbnail.active { border-color: var(--accent); }
.modal-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
.modal-details { padding: clamp(24px, 4vw, 46px); }
.modal-close { position: absolute; z-index: 1; inset-block-start: 13px; inset-inline-end: 13px; }
.modal-details h2 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.1; }
.modal-description { margin: 22px 0; color: var(--muted); line-height: 1.85; }
.size-options { display: flex; gap: 8px; flex-wrap: wrap; margin: 9px 0 24px; }
.size-option { min-width: 44px; height: 39px; padding: 0 12px; border: 1px solid var(--border-subtle); border-radius: 8px; background: transparent; color: var(--text); font-weight: 800; }
.size-option.selected, .size-option:hover { border-color: var(--accent); color: var(--accent); background: rgba(200,169,110,.08); }
.modal-cart-button { width: 100%; }

.detail-grid { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(320px, .96fr); gap: clamp(28px, 5vw, 70px); }
.detail-image { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-modal); border: 1px solid var(--border-subtle); background: var(--black-elevated); }
.detail-thumbnails { display: flex; gap: 10px; margin-top: 12px; overflow: auto; }
.detail-thumb { width: 70px; height: 70px; flex: 0 0 70px; padding: 0; overflow: hidden; border: 1px solid transparent; border-radius: 8px; background: var(--black-elevated); }
.detail-thumb.selected { border-color: var(--accent); }
.detail-thumb img { width: 100%; height: 100%; object-fit: cover; }
.detail-info { padding: clamp(20px, 3vw, 36px); }
.detail-info h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.05; }
.detail-price { margin: 18px 0; color: var(--accent); font-size: 1.5rem; font-weight: 900; }

.split-page { display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, .72fr); gap: 32px; align-items: start; }
.cart-items { display: grid; gap: 13px; }
.cart-item { display: grid; grid-template-columns: 94px 1fr auto; gap: 18px; align-items: center; padding: 14px; }
.cart-item img { width: 94px; height: 94px; border-radius: 9px; object-fit: cover; background: var(--black-elevated); }
.cart-item-title { margin: 0 0 6px; color: var(--text); font-size: 1rem; font-weight: 800; }
.cart-item-meta { color: var(--muted); font-size: .85rem; }
.cart-item-actions { display: flex; align-items: center; gap: 10px; }
.quantity-input { width: 64px; min-height: 37px; padding: 3px 7px; background: var(--black); color: var(--text); border: 1px solid var(--border-subtle); border-radius: 7px; }
.remove-button { border: 0; background: transparent; color: #c87777; font-size: .78rem; font-weight: 800; }
.remove-button:hover { color: #f2a0a0; }
.totals { padding: 24px; }
.totals h2 { margin: 0 0 18px; font-size: 1.25rem; }
.total-row { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border-subtle); color: var(--muted); }
.total-row:last-of-type { color: var(--text); border-bottom: 0; font-weight: 900; font-size: 1.12rem; }
.total-row strong { color: var(--accent); }
.empty-state { padding: 65px 25px; text-align: center; }
.empty-state p { color: var(--muted); }

.checkout-form { padding: clamp(22px, 4vw, 38px); }
.form-title { margin: 0 0 22px; font-size: 1.35rem; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
.form-grid .full { grid-column: 1 / -1; }
.payment-options { display: grid; gap: 10px; }
.payment-option { display: flex; align-items: center; gap: 12px; min-height: 53px; padding: 10px 13px; border: 1px solid var(--border-subtle); border-radius: 9px; color: var(--muted); cursor: pointer; }
.payment-option.selected { border-color: var(--accent); color: var(--text); background: rgba(200,169,110,.07); }
.payment-indicator { width: 13px; height: 13px; border: 1px solid var(--muted); border-radius: 50%; }
.payment-option.selected .payment-indicator { border: 4px solid var(--accent); }
.payment-option img { max-height: 20px; max-width: 72px; margin-inline-start: auto; }

.auth-wrap { width: min(100%, 460px); margin: 34px auto; padding: clamp(26px, 5vw, 46px); }
.auth-wrap h1 { margin: 0 0 8px; font-size: 2.1rem; }
.auth-wrap form { display: grid; gap: 13px; margin-top: 25px; }
.auth-switch { margin: 18px 0 0; color: var(--muted); font-size: .88rem; }
.text-link { border: 0; padding: 0; background: transparent; color: var(--accent); font-weight: 800; }

.info-hero { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 74px); align-items: center; }
.info-hero img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--border-subtle); border-radius: var(--radius-modal); filter: saturate(.7); }
.info-copy h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 4.2rem); line-height: 1; }
.info-copy p { color: var(--muted); line-height: 1.9; }
.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 50px; }
.pillar { padding: 24px; }
.pillar strong { display: block; margin-bottom: 8px; color: var(--accent); }
.pillar p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.7; }
.contact-details { display: grid; gap: 18px; margin-top: 22px; }
.contact-detail { padding: 18px; }
.contact-detail strong { display: block; margin-bottom: 4px; color: var(--accent); }
.contact-detail span { color: var(--muted); }

.order-list { display: grid; gap: 14px; }
.order-card { padding: 20px; }
.order-summary { display: flex; justify-content: space-between; align-items: start; gap: 15px; cursor: pointer; }
.order-card h2 { margin: 0; font-size: 1.03rem; }
.order-status { color: var(--accent); font-size: .76rem; font-weight: 900; text-transform: uppercase; }
.order-details { display: grid; gap: 10px; margin-top: 17px; padding-top: 16px; border-top: 1px solid var(--border-subtle); }
.order-product { display: grid; grid-template-columns: 54px 1fr auto; align-items: center; gap: 11px; color: var(--muted); font-size: .88rem; }
.order-product img { width: 54px; height: 54px; border-radius: 7px; object-fit: cover; }

.site-footer { margin-top: auto; border-top: 1px solid var(--border-subtle); background: #090909; }
.footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 38px; padding-block: 52px; }
.footer-logo { width: 105px; height: 58px; object-fit: contain; }
.footer-text { max-width: 390px; color: var(--muted); line-height: 1.8; }
.footer-title { margin: 5px 0 15px; color: var(--text); font-size: .82rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
.footer-links { display: grid; gap: 9px; }
.footer-links a, .footer-links span { color: var(--muted); font-size: .9rem; text-decoration: none; }
.footer-links a:hover { color: var(--accent); }
.footer-bottom { padding-block: 18px; border-top: 1px solid var(--border-subtle); color: #74716b; font-size: .78rem; text-align: center; }

.Toastify__toast { background: #171717; color: var(--text); border: 1px solid var(--border-subtle); font-family: 'Tajawal', sans-serif; }
.Toastify__progress-bar { background: var(--accent); }

@media (max-width: 1024px) {
  .products-grid, .skeleton-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .collection-layout { grid-template-columns: 210px 1fr; gap: 22px; }
  .pillars { grid-template-columns: 1fr; }
}
@media (max-width: 767px) {
  .page-container, .header-inner, .hero-grid { width: min(100% - 30px, 1320px); }
  .page-content { padding-block: 32px 58px; }
  .desktop-nav, .header-actions .profile-menu, .header-actions .language-button { display: none; }
  .mobile-trigger { display: inline-grid; }
  .header-inner { min-height: 65px; }
  .header-logo img { width: 80px; height: 45px; }
  .hero { min-height: auto; }
  .hero-grid, .info-hero, .detail-grid, .split-page, .product-modal { grid-template-columns: 1fr; }
  .hero-grid { padding-block: 58px; }
  .hero-copy { text-align: center; }
  .hero-actions { justify-content: center; }
  .hero-note { inset-inline-start: 10px; inset-block-end: 10px; }
  .hero-image-wrap { max-width: 500px; margin: auto; }
  .section-heading { display: block; }
  .section-heading p { margin-top: 12px; }
  .collection-layout { display: block; }
  .filters { margin-bottom: 22px; }
  .filter-toggle { display: inline-flex; margin-bottom: 15px; }
  .filters-content.collapsed { display: none; }
  .products-grid, .skeleton-grid { gap: 12px; }
  .product-info { padding: 11px; }
  .product-category { font-size: .59rem; }
  .product-name { font-size: .84rem; }
  .product-price { font-size: .83rem; }
  .quick-view { font-size: .65rem; }
  .modal-backdrop { align-items: start; padding: 14px; }
  .product-modal { margin-block: 20px; }
  .modal-gallery, .modal-details { padding: 18px; }
  .split-page { gap: 20px; }
  .cart-item { grid-template-columns: 72px 1fr; gap: 12px; }
  .cart-item img { width: 72px; height: 72px; }
  .cart-item-actions { grid-column: 1 / -1; justify-content: space-between; }
  .form-grid { grid-template-columns: 1fr; }
  .form-grid .full { grid-column: auto; }
  .footer-grid { grid-template-columns: 1fr; gap: 25px; padding-block: 36px; }
}
